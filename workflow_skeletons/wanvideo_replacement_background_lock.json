    },
    {
      "from": ["wan_sampler_extra_args", "extra_args"],
      "to": ["wan_sampler", "extra_args"],
      "type": "WANVIDSAMPLEREXTRAARGS"
    }
  ],
  "background_lock_contract": {
    "required": true,
    "conditioning_alone_hard_preserves_background": false,
    "mask_source": "SCAILPose2ReplacementDenoiseMask.mask",
    "reference_geometry_source": "SCAILPose2SCAIL2Condition.replacement_only_auto_alignment",
    "encode_node": "WanVideoEncode",
    "encode_driving_video_socket": "driving_video",
    "encode_mask_socket": "mask",
    "sampler_samples_socket": "samples",
    "sampler_add_noise_to_samples": true,
    "mask_polarity": {
      "subject_replace_area": 1.0,
      "background_preserve_area": 0.0
    },
    "pose_geometry_alignment_required": false,
    "condition_video_source": "workflow_inputs.driving_video -> scail2_condition.driving_video",
    "replacement_condition_video_fallback": {
      "status": "legacy_experimental_manual",
      "purpose": "manual subject suppression experiments only; not canonical replacement wiring",
      "may_weaken_pose_latents": true,
      "does_not_replace_samples_path": true
    },
    "wrapper_strength_controls": {
      "defaults_preserve_existing_behavior": true,
      "ref_image_strength": "reference image latent multiplier",
      "ref_mask_strength": "reference mask embedding multiplier",
      "condition_video_strength": "condition video latent multiplier",
      "driving_mask_strength": "driving mask embedding multiplier"
    },
    "render_nlf_poses_required": false,
    "preview_contract": {
      "early_preview_background_may_be_noisy": true,
      "preview_is_final_preservation_evidence": false,
      "final_preservation_requires_samples_noise_mask_path": true
    },
    "wrapper_noise_mask_contract": {
      "metadata_required": true,
      "condition_mode_attr": "scail_pose2_condition_mode",
      "mask_role_attr": "scail_pose2_mask_role",
      "replacement_mask_role": "replacement_denoise_mask",
      "tagged_interpolation_policy": "nearest_binary",
      "untagged_policy": "downstream_default"
    },
    "context_frame_map_contract": {
      "context_owner": "WanVideoContextOptions",
      "adapter_input_socket": "context_options",
      "sampler_socket": "extra_args",
      "route": "WanVideoContextOptions.context_options -> WanVideoSamplerExtraArgs.context_options -> WanVideoSamplerv2.extra_args",
      "core_does_not_schedule_context_windows": true,
      "pose_latents_and_driving_masks_must_share_frame_count": true,
      "samples_and_noise_mask_must_share_latent_timeline": true
    }
  },
  "multi_person_identity_contract": {
    "selected_objects_define_identity_order": true,
    "identity_palette": ["blue", "red", "green", "magenta", "cyan", "yellow"],
    "additional_reference_slots_supported": true,
    "under_provisioned_references_are_warnings": true
  },
  "warnings": [
    "This static skeleton documents replacement background-lock wiring and does not execute generation.",
    "SCAIL-2 conditioning guides the model, but hard background preservation requires the WanVideoEncode samples/noise_mask path.",
    "Live inference still requires a compatible WanVideoWrapper build, Wan model assets, VAE, text embeds, scheduler, and user runtime configuration."
  ]
}
