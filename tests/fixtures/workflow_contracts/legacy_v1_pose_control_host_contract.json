{
  "schema": "scail_pose2.workflow_contract.v1",
  "workflow_id": "legacy-v1-pose-control-host-subgraph",
  "classification": "static_host_subgraph",
  "mode": "legacy_v1_pose_control",
  "execution": "static_only",
  "executable": false,
  "host": {
    "family": "kijai-vanilla",
