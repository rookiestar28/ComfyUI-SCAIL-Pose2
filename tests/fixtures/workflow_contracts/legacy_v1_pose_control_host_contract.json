  "nodes": [
    {
      "id": "empty",
      "class_type": "WanVideoEmptyEmbeds",
      "inputs": {"width": 512, "height": 512, "num_frames": 81}
    },
    {
      "id": "clip",
      "class_type": "WanVideoClipVisionEncode",
      "inputs": {
        "clip_vision": "external-clip-vision",
        "image_1": "external-reference-image",
        "strength_1": 1.0,
        "strength_2": 1.0,
        "crop": "center",
        "combine_embeds": "average",
        "force_offload": true
