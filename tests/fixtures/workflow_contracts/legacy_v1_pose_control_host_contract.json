    },
    {
      "id": "reference",
      "class_type": "WanVideoAddSCAILReferenceEmbeds",
      "inputs": {
        "vae": "external-vae",
        "ref_image": "external-reference-image",
        "strength": 1.0,
        "start_percent": 0.0,
        "end_percent": 1.0
      }
    },
    {
      "id": "pose",
      "class_type": "WanVideoAddSCAILPoseEmbeds",
      "inputs": {
        "vae": "external-vae",
        "pose_images": "external-rendered-pose-images",
        "strength": 1.0,
        "start_percent": 0.0,
        "end_percent": 1.0
      }
    },
    {
      "id": "sampler",
      "class_type": "WanVideoSamplerv2",
      "inputs": {
        "model": "external-model",
        "cfg": 5.0,
        "seed": 0,
        "force_offload": true,
        "scheduler": "external-scheduler",
        "text_embeds": "external-text-embeds"
      }
    }
  ],
  "links": [
    {"from": ["empty", "image_embeds"], "to": ["reference", "embeds"], "type": "WANVIDIMAGE_EMBEDS"},
    {"from": ["clip", "image_embeds"], "to": ["reference", "clip_embeds"], "type": "WANVIDIMAGE_CLIPEMBEDS"},
    {"from": ["reference", "image_embeds"], "to": ["pose", "embeds"], "type": "WANVIDIMAGE_EMBEDS"},
    {"from": ["pose", "image_embeds"], "to": ["sampler", "image_embeds"], "type": "WANVIDIMAGE_EMBEDS"}
  ]
